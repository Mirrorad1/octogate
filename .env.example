# Octogate Hub Configuration Example
# Copy this to .env and fill in actual values

# ========== x402 Payment Configuration ==========
# Fee wallet address (where settlement fees are collected)
PAY_TO=0x742d35Cc6634C0532925a3b844Bc9e7595f42521

# Blockchain network (e.g., "eip155:84532" for Base Sepolia, "eip155:8453" for Base Mainnet)
NETWORK=eip155:84532

# Default price in USDC (e.g., "0.001" for $0.001)
PRICE=0.001

# Settlement smart contract address on the chosen network
SETTLEMENT_CONTRACT=0x123456789abcdef123456789abcdef1234567890

# x402 Facilitator URL (Coinbase hosted service for payment verification)
X402_FACILITATOR_URL=https://x402.org/facilitator

# ========== Database Configuration ==========
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://octogate:octogate@localhost:5432/octogate_sepolia?sslmode=disable

# ========== Blockchain RPC Configuration ==========
# Primary RPC endpoint (WebSocket for event subscription)
# Alchemy free tier: wss://base-sepolia.g.alchemy.com/v2/{API_KEY}
# Infura: wss://base-sepolia.infura.io/ws/v3/{PROJECT_ID}
RPC_PRIMARY=wss://base-sepolia.g.alchemy.com/v2/demo

# Fallback RPC endpoint (used if primary fails)
RPC_FALLBACK=wss://base-sepolia.infura.io/ws/v3/demo

# ========== Hub Configuration ==========
# Port to listen on
PORT=8080

# Admin token for protected endpoints (random value)
ADMIN_TOKEN=your_random_32_char_hex_here_12345

# Skip payment verification (ONLY for local testing, NEVER in production)
X402_SKIP_VERIFY=false

# ========== Logging Configuration ==========
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ========== CORS Configuration ==========
# Allowed origins for cross-origin requests (comma-separated)
CORS_ALLOWED_ORIGINS=*
